#!/bin/sh
# kit launcher for Linux/macOS. install.sh puts a small script on your PATH that runs this.
# Symlinking this file onto PATH yourself works too; the loop below resolves the link.
set -e

self=$0
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname "$self")/$target ;;
    esac
done
kit_home=$(cd "$(dirname "$self")/.." && pwd)

# Run inside the repo's uv environment so tools can use the packages in pyproject.toml.
# KIT_PYTHON skips uv and uses that interpreter directly.
if [ -n "${KIT_PYTHON:-}" ]; then
    exec "$KIT_PYTHON" "$kit_home/kit.py" "$@"
elif command -v uv >/dev/null 2>&1; then
    exec uv run --quiet --project "$kit_home" python "$kit_home/kit.py" "$@"
elif command -v python3 >/dev/null 2>&1; then
    exec python3 "$kit_home/kit.py" "$@"
else
    exec python "$kit_home/kit.py" "$@"
fi
